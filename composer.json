{
  "name": "emailsherlock/client",
  "description": "Official PHP client for the EmailSherlock email-verification API.",
  "type": "library",
  "license": "MIT",
  "keywords": ["email", "email-verification", "email-validation", "emailsherlock", "mx", "smtp", "disposable"],
  "homepage": "https://emailsherlock.com/api/docs",
  "authors": [{ "name": "EmailSherlock" }],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": { "Emailsherlock\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Emailsherlock\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": { "sort-packages": true }
}
